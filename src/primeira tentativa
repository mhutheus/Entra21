use test42;

CREATE TABLE pessoas (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    idade INT
);

CREATE TABLE gostos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    pessoa_id INT,
    jogoFavorito VARCHAR(100),
    comidaFavorita VARCHAR(100),

    FOREIGN KEY (pessoa_id) REFERENCES pessoas(id)
);

