select * from pessoas;

select * from gostos;

SELECT *
FROM gostos g
JOIN pessoas p
ON g.pessoa_id = p.id;

SELECT
    g.id,
    p.nome AS NOME,
    p.idade AS IDADE,
    g.jogoFavorito AS JOGO_FAVORITO,
    g.comidaFavorita AS COMIDA_FAVORITA
FROM gostos g, pessoas p
WHERE g.pessoa_id = p.id;

SELECT
    g.id,
    p.nome AS NOME,
    p.idade AS IDADE,
    g.jogoFavorito AS JOGO_FAVORITO,
    g.comidaFavorita AS COMIDA_FAVORITA
FROM gostos g, pessoas p
WHERE g.pessoa_id = p.id
AND g.id = 1;

show tables;
