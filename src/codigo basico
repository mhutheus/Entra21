-- CRIANDO TABELA BASE

CREATE TABLE tb_testes(
id_tb_teste INT PRIMARY KEY auto_increment,
numeros INT,
palavras VARCHAR(100)
);

insert into tb_testes(numeros, palavras)
values
(100, 'banana'),
(200, 'carro'),
(300, 'celular');

-- BUSCANDO DADOS

DELIMITER $$
CREATE PROCEDURE listarDados()
BEGIN

	SELECT * FROM tb_testes;

END $$

DELIMITER ;

CALL listarDados();

-- INSERINDO DADOS

DELIMITER $$
CREATE PROCEDURE adicionarDados(
IN p_numero INT,
IN p_palavra VARCHAR(100)
)
BEGIN

	insert into tb_testes(numeros, palavras)
	Value (p_numero, p_palavra);

END $$

DELIMITER ;

CALL adicionarDados(400, 'garrafa');

-- CONTAR LINHAS

DELIMITER $$
CREATE PROCEDURE totalNumeros(
OUT quantidade INT
)
