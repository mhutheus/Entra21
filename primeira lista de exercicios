select 
ip.id_pedido,
p.nome_cliente,
p.data_pedido,
pr.nome as produto,
ip.quantidade,
ip.valor_unitario,
(ip.quantidade * ip.valor_unitario) as subtotal,
SUM(ip.quantidade * ip.valor_unitario) OVER (PARTITION BY ip.id_pedido) AS total
from tb_itensPedidos ip
inner join tb_pedidos p on ip.id_pedido = p.id_pedido
inner join tb_produtos pr on ip.id_produto = pr.id_produto
where ip.id_pedido = 1;


